# ============================================================
# KINETIC FLOW — .gitignore
# ============================================================

# --- Node Dependencies ---
node_modules/
**/node_modules/

# --- Environment Variable Files (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env
frontend/.env
# Allow the template file
!.env.example
!backend/.env.example

# --- Build Output ---
dist/
dist-ssr/
build/
*.tsbuildinfo

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime & Cache ---
.cache/
.parcel-cache/
.vite/
.eslintcache
*.tgz
.npm

# --- OS & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Test Coverage ---
coverage/
*.lcov
.nyc_output/

# Kinetic Flow — Environment Variables Template
# =====================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# HOW TO GET YOUR HUGGING FACE TOKEN:
# 1. Go to https://huggingface.co/settings/tokens
# 2. Click "New token" → set role to "Read"
# 3. Copy the token and paste it below (replace hf_XXXX...)

# --- Required ---
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Optional ---
PORT=3000
